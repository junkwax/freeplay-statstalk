# freeplay-stats local dev
# Copy to .env and fill in values

STATS_API_KEY=dev-key-change-me
DISCORD_WEBHOOK_URL=
DB_PATH=stats.db
PORT=8081
RUST_LOG=freeplay_stats=debug,tower_http=debug

# Shared with the signaling server. Required for ghost upload (the client
# JWT is verified locally instead of round-tripping through signaling).
# Generate with: openssl rand -base64 48
JWT_SECRET=
